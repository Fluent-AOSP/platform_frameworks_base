<resources>
    <!-- The maximum width of the shade overlay panel (both notifications and quick settings). -->
    <dimen name="shade_panel_width">600dp</dimen>

    <!--
    The horizontal distance between the shade overlay panel (both notifications and quick settings)
    and the edge of the screen. Compact layouts use the Fluent small-window gutter.
    -->
    <dimen name="shade_panel_margin_horizontal">12dp</dimen>

    <dimen name="qs_shape_panel_corner_radius">8dp</dimen>
    <dimen name="overlay_shade_panel_shape_radius">@dimen/qs_shape_panel_corner_radius</dimen>

    <!-- QS shade overlay common tiles -->
    <!-- Component-semantic shape tokens keep tile styling separate from state behavior. -->
    <dimen name="qs_shape_brightness_container_corner_radius">4dp</dimen>
    <dimen name="qs_shape_edit_grid_corner_radius">8dp</dimen>
    <dimen name="qs_shape_icon_active_corner_radius">4dp</dimen>
    <dimen name="qs_shape_icon_inactive_corner_radius">4dp</dimen>
    <dimen name="qs_shape_tile_active_corner_radius">4dp</dimen>
    <dimen name="qs_shape_tile_inactive_corner_radius">4dp</dimen>
    <dimen name="qs_shape_toolbar_button_background_corner_radius">4dp</dimen>
    <dimen name="qs_shape_toolbar_feedback_corner_radius">4dp</dimen>
    <dimen name="qs_size_tile_icon_only_icon">20dp</dimen>
    <dimen name="qs_size_tile_labeled_icon">20dp</dimen>
    <dimen name="qs_spacing_tile_content">8dp</dimen>
    <dimen name="qs_spacing_tile_start">8dp</dimen>
    <dimen name="qs_spacing_tile_end">12dp</dimen>
    <dimen name="qs_spacing_tile_dual_target_end">8dp</dimen>
    <dimen name="qs_tooltip_corner_radius">4dp</dimen>
    <dimen name="common_tile_default_active_icon_corner_radius">@dimen/qs_shape_icon_active_corner_radius</dimen>
    <dimen name="common_tile_default_active_tile_corner_radius">@dimen/qs_shape_tile_active_corner_radius</dimen>
    <dimen name="common_tile_default_content_spacing">@dimen/qs_spacing_tile_content</dimen>
    <dimen name="common_tile_default_dual_target_end_padding">@dimen/qs_spacing_tile_dual_target_end</dimen>
    <dimen name="common_tile_default_end_padding">@dimen/qs_spacing_tile_end</dimen>
    <dimen name="common_tile_default_icon_size">@dimen/qs_size_tile_icon_only_icon</dimen>
    <dimen name="common_tile_default_inactive_icon_corner_radius">@dimen/qs_shape_icon_inactive_corner_radius</dimen>
    <dimen name="common_tile_default_inactive_tile_corner_radius">@dimen/qs_shape_tile_inactive_corner_radius</dimen>
    <dimen name="common_tile_default_large_tile_icon_size">@dimen/qs_size_tile_labeled_icon</dimen>
    <dimen name="common_tile_default_start_padding">@dimen/qs_spacing_tile_start</dimen>
    <dimen name="common_tile_default_tile_height">56dp</dimen>
    <dimen name="common_tile_default_toggle_target_size">48dp</dimen>

    <!-- QS shade overlay brightness bar -->
    <dimen name="overlay_qs_layout_brightness_icon_size">20dp</dimen>
    <dimen name="overlay_qs_layout_brightness_thumb_height">48dp</dimen>
    <dimen name="overlay_qs_layout_brightness_thumb_width">4dp</dimen>
    <dimen name="overlay_qs_layout_brightness_track_height">32dp</dimen>
    <dimen name="overlay_qs_layout_brightness_vertical_padding">4dp</dimen>
    <dimen name="overlay_qs_layout_brightness_rounded_corner">@dimen/qs_shape_brightness_container_corner_radius</dimen>
    <dimen name="overlay_qs_layout_brightness_frame_width">8dp</dimen>
    <dimen name="overlay_qs_layout_brightness_frame_height">4dp</dimen>
    <dimen name="overlay_qs_layout_toolbar_height">48dp</dimen>

    <!-- QS shade layout -->
    <!-- The horizontal padding and the vertical padding can be different in alternative resources -->
    <dimen name="overlay_qs_layout_horizontal_padding">12dp</dimen>
    <dimen name="overlay_qs_layout_vertical_padding">12dp</dimen>

    <!-- QS shade overlay volume bar -->
    <dimen name="overlay_qs_layout_volume_extra_padding">12dp</dimen>
    <dimen name="overlay_qs_layout_volume_vertical_padding">4dp</dimen>
    <dimen name="overlay_qs_layout_volume_thumb_height">
        @dimen/overlay_qs_layout_brightness_thumb_height
    </dimen>
    <dimen name="overlay_qs_layout_volume_thumb_width">
        @dimen/overlay_qs_layout_brightness_thumb_width
    </dimen>
    <dimen name="overlay_qs_layout_volume_track_height">
        @dimen/overlay_qs_layout_brightness_track_height
    </dimen>

    <!-- QS shade overlay toolbar -->
    <dimen name="toolbar_bottom_padding">8dp</dimen>
    <dimen name="toolbar_button_colored_background_size">32dp</dimen>
    <dimen name="toolbar_button_icon_size">20dp</dimen>
    <dimen name="toolbar_button_size">48dp</dimen>

    <!-- QS shade focus rings -->
    <dimen name="focus_ring_wide_corner_radius">50dp</dimen>
    <dimen name="focus_ring_tight_corner_radius">12dp</dimen>
</resources>
