<resources>
    <!--
      Shared resting-card roles for the transient Fluent shade. The translucent values are the
      source-over composition of WinUI CardBackgroundFillColorDefault on
      ControlOnImageFillColorDefault from microsoft-ui-xaml commit
      6112d936461edb6d81ce7db983c74cc60ea2bc28.
    -->
    <color name="fluent_shell_card_fill_translucent_light">#EFFFFFFF</color>
    <color name="fluent_shell_card_fill_translucent_dark">#B72C2C2C</color>
    <color name="fluent_shell_card_fill_opaque_light">#FFFFFFFF</color>
    <color name="fluent_shell_card_fill_opaque_dark">#FF2C2C2C</color>
    <color name="fluent_shell_card_stroke_light">#0F000000</color>
    <color name="fluent_shell_card_stroke_dark">#19000000</color>
</resources>
